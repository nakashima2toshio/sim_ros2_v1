# docker-compose/docker-compose.yml が参照する設定。
# 使うときは `cp .env.example .env` してから編集する（.env は Git 管理しない）。
#
# ⚠️ この .env は scripts/*.sh（up.sh など）経由で起動したときに読まれる。
#    docker compose を直接叩く場合は --env-file .env を付けること
#    （Compose は既定では docker-compose/ の中の .env しか探さない）。

# --- DDS -------------------------------------------------------------------
# 同一 LAN の他マシンと混線する場合に変更する。
ROS_DOMAIN_ID=42
# LOCALHOST / SUBNET / OFF / SYSTEM_DEFAULT
# 学習用途では LOCALHOST を推奨（同一ホスト内のノードとだけ通信する）。
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# --- GUI -------------------------------------------------------------------
START_GUI=1
DISPLAY_NUM=:1
SCREEN_SIZE=1920x1080x24

# --- ホスト側ポート（他アプリと衝突する場合に変更）-----------------------------
# すべて 127.0.0.1（この Mac 自身）からのみ接続できる。
NOVNC_PORT=6080
FOXGLOVE_PORT=8765
DEBUGPY_PORT=5678
# 以下は学習後半（P28 Web 連携）で docker-compose.yml の ports を有効にしてから使う。
# ROSBRIDGE_PORT=9090
# API_PORT=8000
#
# VNC（5900）はホストに公開しない。macOS の「画面共有」が 5900 を使っており衝突するため。
# noVNC（ブラウザ）で画面を見る分には不要。

# --- シミュレーション --------------------------------------------------------
SIM_WORLD=empty
