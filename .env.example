# docker-compose/docker-compose.yml が参照する設定。
# 使うときは `cp .env.example .env` してから編集する（.env は Git 管理しない）。

# --- DDS -------------------------------------------------------------------
# 同一 LAN の他マシンと混線する場合に変更する。
ROS_DOMAIN_ID=42
# LOCALHOST / SUBNET / OFF / SYSTEM_DEFAULT
# 学習用途では LOCALHOST を推奨（同一ホスト内のノードとだけ通信する）。
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# --- GUI -------------------------------------------------------------------
START_GUI=1
DISPLAY_NUM=:1
SCREEN_SIZE=1920x1080x24

# --- ホスト側ポート（他アプリと衝突する場合に変更）-----------------------------
NOVNC_PORT=6080
VNC_PORT=5900
FOXGLOVE_PORT=8765
ROSBRIDGE_PORT=9090
API_PORT=8000
DEBUGPY_PORT=5678

# --- シミュレーション --------------------------------------------------------
SIM_WORLD=empty
